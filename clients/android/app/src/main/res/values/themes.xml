<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Deepsplat" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Deepsplat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ink</item>
        <item name="postSplashScreenTheme">@style/Theme.Deepsplat</item>
    </style>
</resources>
