<?xml version="1.0" encoding="utf-8"?>
<!-- Android cannot scope cleartext to IP ranges. The app itself only accepts http:// for
     private-network hosts (data/Network.kt, same rule as the iOS app); everything else must be https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system"/></trust-anchors>
    </base-config>
</network-security-config>
