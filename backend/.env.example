# detection
DETECTOR=roboflow_sam3          # or "fake" (offline)
ROBOFLOW_API_KEY=
# visual positioning
VPS=sift                        # free CPU VPS; "hloc" needs localization/requirements-vps.txt; "none"
# storage / database
STORAGE=local                   # "gcs" on Google Cloud
GCS_BUCKET=
DATABASE_URL=sqlite:///data/deepsplat.db   # Cloud SQL: postgresql+psycopg://user:pass@/db?host=/cloudsql/<instance>
DATA_DIR=data
PUBLIC_BASE_URL=http://localhost:8000
# auth for the app / clients (empty = open, local only)
API_TOKEN=
# quality gates
MIN_POSE_CONFIDENCE=0.5
REJECT_LOW_QUALITY_IMAGES=false
