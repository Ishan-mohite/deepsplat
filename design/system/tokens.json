{
  "$description": "deepsplat design tokens (W3C design tokens format). Mirrors tokens.css; docs in DESIGN.md.",
  "color": {
    "paper": {
      "$type": "color",
      "$value": "#F1EEE6",
      "$description": "Page background"
    },
    "paper-2": {
      "$type": "color",
      "$value": "#E8E2D4",
      "$description": "Sunken areas, hero panels, inactive tracks"
    },
    "card": {
      "$type": "color",
      "$value": "#FBFAF7",
      "$description": "Cards, sheets, inputs"
    },
    "ink": {
      "$type": "color",
      "$value": "#172033",
      "$description": "Primary text, dark buttons, selected nav"
    },
    "ink-2": {
      "$type": "color",
      "$value": "#4A5163",
      "$description": "Secondary text, metadata"
    },
    "muted": {
      "$type": "color",
      "$value": "#7D786A",
      "$description": "Hints, axis labels; large or non-essential text only"
    },
    "line": {
      "$type": "color",
      "$value": "#E2DCCF",
      "$description": "Card borders, dividers"
    },
    "line-2": {
      "$type": "color",
      "$value": "#D3CBBB",
      "$description": "Control borders"
    },
    "blue": {
      "$type": "color",
      "$value": "#2453D4",
      "$description": "Primary action, links, located/known, closed findings"
    },
    "blue-soft": {
      "$type": "color",
      "$value": "#E3E9FB"
    },
    "rust": {
      "$type": "color",
      "$value": "#C24A1C",
      "$description": "Open findings, attention, newest record"
    },
    "rust-soft": {
      "$type": "color",
      "$value": "#F7E5DB"
    },
    "green": {
      "$type": "color",
      "$value": "#2F7D4B",
      "$description": "Live and success: Scan active, saved, repaired"
    },
    "green-soft": {
      "$type": "color",
      "$value": "#E1EFE3"
    },
    "amber": {
      "$type": "color",
      "$value": "#946300",
      "$description": "Warnings that are not findings"
    },
    "amber-soft": {
      "$type": "color",
      "$value": "#F6ECD2"
    },
    "viewport": {
      "bg": {
        "$type": "color",
        "$value": "#1A2130"
      },
      "bg-2": {
        "$type": "color",
        "$value": "#232C3E"
      },
      "line": {
        "$type": "color",
        "$value": "#36435C"
      },
      "ink": {
        "$type": "color",
        "$value": "#E9ECF3"
      },
      "muted": {
        "$type": "color",
        "$value": "#9AA4B8"
      },
      "pick": {
        "$type": "color",
        "$value": "#7EA2FF"
      },
      "rust": {
        "$type": "color",
        "$value": "#E8784A"
      }
    },
    "severity": {
      "low": {
        "$type": "color",
        "$value": "#7C8DA6"
      },
      "medium": {
        "$type": "color",
        "$value": "#C98500"
      },
      "high": {
        "$type": "color",
        "$value": "#D95926"
      },
      "critical": {
        "$type": "color",
        "$value": "#B3261E"
      }
    },
    "segmentation": {
      "1": {
        "$type": "color",
        "$value": "#3987E5"
      },
      "2": {
        "$type": "color",
        "$value": "#D95926"
      },
      "3": {
        "$type": "color",
        "$value": "#199E70"
      },
      "4": {
        "$type": "color",
        "$value": "#C98500"
      },
      "5": {
        "$type": "color",
        "$value": "#D55181"
      },
      "6": {
        "$type": "color",
        "$value": "#008300"
      },
      "7": {
        "$type": "color",
        "$value": "#9085E9"
      },
      "neutral": {
        "$type": "color",
        "$value": "#8B95A7",
        "$description": "Background / unlabelled"
      }
    },
    "status": {
      "new": {
        "$type": "color",
        "$value": "{color.blue}"
      },
      "worsening": {
        "$type": "color",
        "$value": "{color.rust}"
      },
      "stable": {
        "$type": "color",
        "$value": "{color.ink-2}"
      },
      "repaired": {
        "$type": "color",
        "$value": "{color.green}"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Space Grotesk",
        "system-ui",
        "sans-serif"
      ]
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Sans",
        "system-ui",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": "44px",
        "lineHeight": 1.08,
        "letterSpacing": "-0.025em"
      }
    },
    "display-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 700,
        "fontSize": "32px",
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      }
    },
    "display-m": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "24px",
        "lineHeight": 1.15,
        "letterSpacing": "-0.015em"
      }
    },
    "display-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "18px",
        "lineHeight": 1.25,
        "letterSpacing": "-0.01em"
      }
    },
    "kpi": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "40px",
        "lineHeight": 1,
        "letterSpacing": "-0.03em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": "15px",
        "lineHeight": 1.5,
        "letterSpacing": "0em"
      }
    },
    "body-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 400,
        "fontSize": "13px",
        "lineHeight": 1.45,
        "letterSpacing": "0em"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 500,
        "fontSize": "13px",
        "lineHeight": 1.2,
        "letterSpacing": "0em"
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontWeight": 600,
        "fontSize": "14px",
        "lineHeight": 1,
        "letterSpacing": "0em"
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.display}",
        "fontWeight": 600,
        "fontSize": "11px",
        "lineHeight": 1,
        "letterSpacing": "0.14em"
      },
      "$description": "Uppercase, blue"
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 400,
        "fontSize": "13px",
        "lineHeight": 1.4,
        "letterSpacing": "0em"
      }
    },
    "mono-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontWeight": 500,
        "fontSize": "11px",
        "lineHeight": 1.3,
        "letterSpacing": "0em"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "14": {
      "$type": "dimension",
      "$value": "56px"
    },
    "18": {
      "$type": "dimension",
      "$value": "72px"
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "22px"
    },
    "md": {
      "$type": "dimension",
      "$value": "14px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "9px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "shadow": {
    "float": {
      "$type": "shadow",
      "$value": {
        "color": "#17203324",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "0px"
      }
    }
  }
}
